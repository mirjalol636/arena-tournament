# Generate independent secrets: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Use URL-safe letters/digits for POSTGRES_PASSWORD or URL-encode it in DATABASE_URL.
POSTGRES_PASSWORD=
JWT_SECRET=
ENVIRONMENT=development
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
PUBLIC_URL=http://localhost:3000
# Optional. The bot stays disabled until both are configured.
TELEGRAM_BOT_TOKEN=
BOT_API_SECRET=
# Development seed only; never used by the application as a default password.
DEMO_PASSWORD=ArenaDemo2026!
